# ==========================================
# DevConnect Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# ==========================================

# --- Project Info ---
PROJECT_NAME=DevConnect
ENVIRONMENT=development

# --- PostgreSQL 15 Database ---
POSTGRES_USER=devconnect
POSTGRES_PASSWORD=devconnect_secret
POSTGRES_DB=devconnect_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://devconnect:devconnect_secret@localhost:5432/devconnect_db

# --- Backend FastAPI & JWT Security ---
BACKEND_PORT=8000
JWT_SECRET_KEY=change-this-super-secret-jwt-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Initial Admin Seed (BR-01) ---
INITIAL_ADMIN_EMAIL=admin@devconnect.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456

# --- Frontend Next.js ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
